<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>Giỏ hàng của bạn - Laptopshop</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="giỏ hàng laptopshop" name="keywords">
    <meta content="Kiểm tra giỏ hàng và thanh toán đơn hàng Laptop chính hãng" name="description">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/client/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="/client/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/client/css/style.css" rel="stylesheet">

    <style>
        .cart-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 16px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
        }

        .cart-table thead th {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 700;
            font-size: 13.5px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 1px solid #e2e8f0;
            padding: 16px 14px;
            white-space: nowrap;
        }

        .cart-table tbody td {
            padding: 18px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .cart-table tbody tr:last-child td {
            border-bottom: none;
        }

        .cart-product-img {
            width: 82px;
            height: 82px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: #f9fafb;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .cart-product-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .cart-product-name {
            font-weight: 700;
            color: #1e293b;
            text-decoration: none;
            font-size: 15px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.2s;
        }

        .cart-product-name:hover {
            color: #81c408;
        }

        .cart-spec-badge {
            display: inline-block;
            background: #f1f5f9;
            color: #475569;
            font-size: 11.5px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 5px;
        }

        .cart-qty-group {
            width: 112px;
            border: 1px solid #cbd5e1;
            border-radius: 50px;
            padding: 3px;
            background: #fff;
        }

        .cart-qty-group .btn {
            width: 28px;
            height: 28px;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: #f1f5f9;
            color: #334155;
            transition: all 0.2s;
        }

        .cart-qty-group .btn:hover {
            background: #81c408;
            color: #fff;
        }

        .btn-remove-cart {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid #fee2e2;
            background: #fef2f2;
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .btn-remove-cart:hover {
            background: #dc2626;
            color: #fff;
            transform: scale(1.05);
        }

        .summary-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
            position: sticky;
            top: 110px;
        }

        .summary-title {
            font-size: 19px;
            font-weight: 800;
            color: #1e293b;
            padding-bottom: 14px;
            border-bottom: 1px solid #e2e8f0;
            margin-bottom: 18px;
        }
    </style>
</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner"
        class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->

    <!-- Navbar start -->
    <%- include('../layout/header') %>
    <!-- Navbar End -->

    <div class="py-4"></div>

    <!-- Cart Page Start -->
    <div class="container-fluid py-5 mt-5">
        <div class="container py-4">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb bg-light px-3 py-2 rounded-3 mb-0">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/products" class="text-decoration-none">Sản phẩm</a></li>
                    <li class="breadcrumb-item active">Giỏ hàng</li>
                </ol>
            </nav>

            <!-- Tiêu đề trang -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                <div>
                    <h2 class="fw-bold text-dark mb-1">Giỏ hàng của bạn</h2>
                    <p class="text-muted small mb-0">
                        <% if (cartDetails && cartDetails.length > 0) { %>
                            Bạn đang có <strong class="text-primary"><%= cartDetails.length %></strong> dòng sản phẩm trong giỏ hàng
                        <% } else { %>
                            Kiểm tra và quản lý các sản phẩm bạn muốn đặt mua
                        <% } %>
                    </p>
                </div>
                <a href="/products" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                    <i class="fas fa-arrow-left me-2"></i> Tiếp tục mua sắm
                </a>
            </div>

            <% if (cartDetails && cartDetails.length > 0) { %>
                <div class="row g-4">
                    <!-- CỘT TRÁI: BẢNG DANH SÁCH SẢN PHẨM -->
                    <div class="col-lg-8">
                        <div class="cart-card overflow-hidden">
                            <div class="table-responsive">
                                <table class="table cart-table mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="ps-4">Sản phẩm</th>
                                            <th scope="col">Đơn giá</th>
                                            <th scope="col" class="text-center">Số lượng</th>
                                            <th scope="col" class="text-end">Thành tiền</th>
                                            <th scope="col" class="text-center pe-4">Xóa</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% cartDetails.forEach(function(cartDetail, index) { %>
                                            <tr>
                                                <!-- Ảnh + Tên + Cấu hình -->
                                                <td class="ps-4" style="min-width: 280px;">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <a href="/detail-product/<%= cartDetail.product.id %>" class="cart-product-img">
                                                            <img src="/images/product/<%= cartDetail.product.thumbnail %>" alt="<%= cartDetail.product.name %>">
                                                        </a>
                                                        <div>
                                                            <a href="/detail-product/<%= cartDetail.product.id %>" class="cart-product-name mb-1" title="<%= cartDetail.product.name %>">
                                                                <%= cartDetail.product.name %>
                                                            </a>
                                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                                <% if (cartDetail.product.cpuType) { %>
                                                                    <span class="cart-spec-badge"><%= cartDetail.product.cpuType %></span>
                                                                <% } %>
                                                                <% if (cartDetail.product.ram) { %>
                                                                    <span class="cart-spec-badge"><%= cartDetail.product.ram %>GB RAM</span>
                                                                <% } %>
                                                                <% if (cartDetail.product.storage) { %>
                                                                    <span class="cart-spec-badge"><%= cartDetail.product.storage >= 1024 ? (cartDetail.product.storage / 1024) + 'TB' : cartDetail.product.storage + 'GB' %></span>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>

                                                <!-- Đơn giá -->
                                                <td class="text-nowrap fw-semibold text-dark">
                                                    <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(cartDetail.priceCurr) %>
                                                </td>

                                                <!-- Bộ tăng giảm số lượng -->
                                                <td>
                                                    <div class="input-group quantity cart-qty-group mx-auto align-items-center">
                                                        <div class="input-group-btn">
                                                            <button type="button" class="btn btn-sm btn-minus rounded-circle">
                                                                <i class="fa fa-minus small"></i>
                                                            </button>
                                                        </div>
                                                        <input type="text"
                                                            class="form-control form-control-sm text-center border-0 fw-bold bg-transparent px-1"
                                                            value="<%= cartDetail.quantity %>"
                                                            data-cart-detail-id="<%= cartDetail.id %>"
                                                            data-cart-detail-price="<%= cartDetail.priceCurr %>"
                                                            data-cart-detail-index="<%= index %>">
                                                        <div class="input-group-btn">
                                                            <button type="button" class="btn btn-sm btn-plus rounded-circle">
                                                                <i class="fa fa-plus small"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>

                                                <!-- Thành tiền từng món -->
                                                <td class="text-end text-nowrap">
                                                    <p class="mb-0 fw-bold text-dark" data-cart-detail-id="<%= cartDetail.id %>">
                                                        <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(cartDetail.quantity * cartDetail.priceCurr) %>
                                                    </p>
                                                </td>

                                                <!-- Nút xóa -->
                                                <td class="text-center pe-4">
                                                    <form action="/delete-product-in-cart/<%= cartDetail.id %>" method="post" class="m-0">
                                                        <button type="submit" class="btn-remove-cart" title="Xóa sản phẩm khỏi giỏ">
                                                            <i class="fas fa-trash-alt small"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Lưu ý ưu đãi dưới bảng giỏ hàng -->
                        <div class="alert alert-success bg-light border border-success rounded-4 mt-3 d-flex align-items-center gap-3 mb-0">
                            <i class="fas fa-gift text-primary fs-4"></i>
                            <div class="small text-dark">
                                <strong>Quà tặng kèm đơn hàng:</strong> Miễn phí Balo Laptop chống sốc cao cấp, chuột không dây và gói cài đặt phần mềm trọn đời.
                            </div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG -->
                    <div class="col-lg-4">
                        <div class="summary-card">
                            <h4 class="summary-title">Tóm tắt đơn hàng</h4>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">Tạm tính</span>
                                <span class="fw-bold text-dark" data-cart-total-price="<%= totalPrice %>">
                                    <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(totalPrice) %>
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">Phí vận chuyển</span>
                                <span class="badge px-3 py-1 rounded-pill fw-semibold"
                                    style="background-color: rgba(25, 135, 84, 0.12); color: #198754; border: 1px solid rgba(25, 135, 84, 0.28);">
                                    Miễn phí (0 đ)
                                </span>
                            </div>

                            <hr class="my-3">

                            <div class="d-flex justify-content-between align-items-baseline mb-4">
                                <span class="fw-bold text-dark fs-5">Tổng cộng</span>
                                <div class="text-end">
                                    <p class="mb-0 fw-extrabold text-danger fs-4" data-cart-total-price="<%= totalPrice %>">
                                        <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(totalPrice) %>
                                    </p>
                                    <small class="text-muted">(Đã bao gồm VAT)</small>
                                </div>
                            </div>

                            <!-- Form chuyển sang trang Checkout -->
                            <form method="post" action="/handle-cart-to-checkout">
                                <div style="display: none">
                                    <% cartDetails.forEach(function(cartDetail, index) { %>
                                        <input type="text" value="<%= cartDetail.id %>" name="cartDetails[<%= index %>][id]" />
                                        <input type="text" value="<%= cartDetail.quantity %>" name="cartDetails[<%= index %>][quantity]" id="cartDetails[<%= index %>]" />
                                    <% }); %>
                                </div>

                                <button type="submit" class="btn btn-primary text-white w-100 rounded-pill py-3 fw-bold text-uppercase shadow-sm">
                                    Xác nhận thanh toán <i class="fas fa-arrow-right ms-2"></i>
                                </button>
                            </form>

                            <div class="mt-3 pt-3 border-top text-center small text-muted">
                                <i class="fas fa-shield-alt text-primary me-1"></i> Thanh toán an toàn &amp; Kiểm tra máy trước khi nhận
                            </div>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <!-- TRẠNG THÁI GIỎ HÀNG TRỐNG -->
                <div class="cart-card text-center py-5 px-3">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-light" style="width: 96px; height: 96px;">
                        <i class="fas fa-shopping-bag fa-3x text-muted"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Giỏ hàng của bạn đang trống</h4>
                    <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
                        Có vẻ như bạn chưa thêm chiếc laptop nào vào giỏ hàng. Hãy khám phá ngay các mẫu laptop chính hãng giá tốt nhất tại Laptopshop!
                    </p>
                    <a href="/products" class="btn btn-primary text-white rounded-pill px-5 py-3 fw-semibold shadow-sm">
                        <i class="fas fa-laptop me-2"></i> Khám phá sản phẩm ngay
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    <!-- Cart Page End -->

    <!-- Footer Start -->
    <%- include('../layout/footer') %>
    <!-- Footer End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top">
        <i class="fa fa-arrow-up"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/waypoints/waypoints.min.js"></script>
    <script src="/client/lib/lightbox/js/lightbox.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="/client/js/main.js"></script>
</body>

</html>