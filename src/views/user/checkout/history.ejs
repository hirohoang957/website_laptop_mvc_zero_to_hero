    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/waypoints/waypoints.min.js"></script>
    <script src="/client/lib/lightbox/js/lightbox.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="/client/js/main.js"></script>

    <!-- Script lọc nhanh đơn hàng & gán ID cho các Modal -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Lọc đơn hàng theo tab trạng thái
            const filterBtns = document.querySelectorAll(".order-filter-btn");
            const orderCards = document.querySelectorAll(".order-history-card[data-order-status]");
            const emptyState = document.getElementById("emptyFilterState");

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filterValue = this.dataset.filter;
                    let visibleCount = 0;

                    orderCards.forEach(card => {
                        if (filterValue === "ALL" || card.dataset.orderStatus === filterValue) {
                            card.style.display = "block";
                            visibleCount++;
                        } else {
                            card.style.display = "none";
                        }
                    });

                    if (emptyState) {
                        emptyState.style.display = visibleCount === 0 ? "block" : "none";
                    }
                });
            });

            // 2. Truyền orderId vào form hủy đơn khi mở Modal
            const cancelForm = document.getElementById("cancelOrderForm");
            const cancelOrderCode = document.getElementById("cancelOrderCode");

            document.querySelectorAll(".btn-open-cancel-modal").forEach(btn => {
                btn.addEventListener("click", function () {
                    const orderId = this.dataset.orderId;
                    if (cancelForm) cancelForm.action = `/cancel-order/${orderId}`;
                    if (cancelOrderCode) cancelOrderCode.textContent = `#ORD-${orderId}`;
                });
            });

            // 3. Truyền orderId vào form xác nhận nhận hàng khi mở Modal
            const confirmForm = document.getElementById("confirmReceivedForm");
            const confirmOrderCode = document.getElementById("confirmOrderCode");

            document.querySelectorAll(".btn-open-confirm-modal").forEach(btn => {
                btn.addEventListener("click", function () {
                    const orderId = this.dataset.orderId;
                    if (confirmForm) confirmForm.action = `/confirm-received/${orderId}`;
                    if (confirmOrderCode) confirmOrderCode.textContent = `#ORD-${orderId}`;
                });
            });

            // 4. Truyền thông tin sản phẩm vào Modal đánh giá & xử lý chọn sao
            const reviewForm = document.getElementById("reviewProductForm");
            const reviewThumb = document.getElementById("reviewModalThumb");
            const reviewName = document.getElementById("reviewModalProductName");
            const ratingInput = document.getElementById("reviewRatingInput");
            const ratingLabel = document.getElementById("ratingTextLabel");
            const starBtns = document.querySelectorAll(".modal-star-btn");
            const ratingDescriptions = {
                1: "Rất tệ (1/5)",
                2: "Không hài lòng (2/5)",
                3: "Bình thường (3/5)",
                4: "Hài lòng (4/5)",
                5: "Tuyệt vời (5/5)"
            };

            function updateStars(value) {
                if (ratingInput) ratingInput.value = value;
                if (ratingLabel) ratingLabel.textContent = ratingDescriptions[value] || "";
                starBtns.forEach(star => {
                    const starVal = Number(star.dataset.value);
                    star.classList.toggle("active", starVal <= value);
                });
            }

            starBtns.forEach(star => {
                star.addEventListener("click", function () {
                    updateStars(Number(this.dataset.value));
                });
            });

            document.querySelectorAll(".btn-open-review-modal").forEach(btn => {
                btn.addEventListener("click", function () {
                    const productId = this.dataset.productId;
                    if (reviewForm) reviewForm.action = `/product/review/${productId}`;
                    if (reviewName) reviewName.textContent = this.dataset.productName;
                    if (reviewThumb) {
                        reviewThumb.src = this.dataset.productThumb;
                        reviewThumb.alt = this.dataset.productName;
                    }
                    updateStars(5);
                });
            });
        });
    </script>
</body>

</html>