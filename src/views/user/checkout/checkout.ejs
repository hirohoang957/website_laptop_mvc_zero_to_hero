<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>Thanh toán đơn hàng - Laptopshop</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="thanh toán laptopshop" name="keywords">
    <meta content="Hoàn tất thông tin giao hàng và thanh toán tại Laptopshop" name="description">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/client/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="/client/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/client/css/style.css" rel="stylesheet">

    <style>
        .checkout-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 16px;
            padding: 28px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
        }

        .checkout-section-title {
            font-size: 19px;
            font-weight: 800;
            color: #1e293b;
            padding-bottom: 12px;
            margin-bottom: 20px;
            border-bottom: 2px solid #f1f5f9;
            position: relative;
        }

        .checkout-section-title::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 55px;
            height: 2px;
            background: #81c408;
        }

        .checkout-input {
            border-radius: 10px;
            padding: 11px 14px;
            border: 1px solid #cbd5e1;
            font-size: 14.5px;
            transition: all 0.2s;
        }

        .checkout-input:focus {
            border-color: #81c408;
            box-shadow: 0 0 0 0.2rem rgba(129, 196, 8, 0.2);
        }

        .payment-option {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px 16px;
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
        }

        .payment-option:hover,
        .payment-option.active {
            border-color: #81c408;
            background-color: rgba(129, 196, 8, 0.05);
        }

        .order-item-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .order-item-row:last-child {
            border-bottom: none;
        }

        .order-item-thumb {
            position: relative;
            width: 64px;
            height: 64px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            background: #f9fafb;
            padding: 5px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .order-item-thumb img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .order-item-qty {
            position: absolute;
            top: -7px;
            right: -7px;
            background: #81c408;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            min-width: 22px;
            height: 22px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

        .order-summary-sticky {
            position: sticky;
            top: 110px;
        }

        .step-badge {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
        }
    </style>
</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner"
        class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->

    <!-- Navbar start -->
    <%- include('../layout/header') %>
    <!-- Navbar End -->

    <div class="py-4"></div>

    <!-- Checkout Page Start -->
    <div class="container-fluid py-5 mt-5">
        <div class="container py-4">

            <!-- Breadcrumb & Thanh tiến trình -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-light px-3 py-2 rounded-3 mb-0">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/cart" class="text-decoration-none">Giỏ hàng</a></li>
                        <li class="breadcrumb-item active">Thanh toán</li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center gap-2 small fw-semibold">
                    <span class="text-success"><span class="step-badge bg-success text-white me-1"><i class="fas fa-check"></i></span> Giỏ hàng</span>
                    <i class="fas fa-chevron-right text-muted mx-1"></i>
                    <span class="text-primary"><span class="step-badge bg-primary text-white me-1">2</span> Thanh toán</span>
                    <i class="fas fa-chevron-right text-muted mx-1"></i>
                    <span class="text-muted"><span class="step-badge bg-light border text-muted me-1">3</span> Hoàn tất</span>
                </div>
            </div>

            <% if (cartDetails && cartDetails.length > 0) { %>
                <form method="post" action="/place-order" id="checkoutForm">
                    <!-- Các trường ẩn khớp 100% với model Order -->
                    <input type="hidden" name="totalPrice" id="finalTotalPriceInput" value="<%= totalPrice %>" />
                    <input type="hidden" name="voucherId" id="voucherIdInput" value="" />
                    <input type="hidden" name="discountAmount" id="discountAmountInput" value="0" />

                    <div class="row g-4">
                        <!-- CỘT TRÁI: THÔNG TIN NGƯỜI NHẬN & PHƯƠNG THỨC THANH TOÁN -->
                        <div class="col-lg-7">
                            <!-- Khối 1: Địa chỉ nhận hàng -->
                            <div class="checkout-card mb-4">
                                <h4 class="checkout-section-title">
                                    <i class="fas fa-map-marker-alt text-primary me-2"></i>Thông tin người nhận hàng
                                </h4>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark">
                                            Họ và tên người nhận <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control checkout-input" name="receiverName"
                                            placeholder="Nhập họ tên người nhận"
                                            value="<%= user?.fullName || '' %>" required />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark">
                                            Số điện thoại liên hệ <span class="text-danger">*</span>
                                        </label>
                                        <input type="tel" class="form-control checkout-input" name="receiverPhone"
                                            placeholder="VD: 0912 345 678"
                                            value="<%= user?.phone || '' %>" required />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold text-dark">
                                            Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control checkout-input" name="receiverAddress"
                                            placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố"
                                            value="<%= user?.address || '' %>" required />
                                    </div>
                                </div>
                            </div>

                            <!-- Khối 2: Hình thức thanh toán (Khớp value "Cod" và "banking" trong schema) -->
                            <div class="checkout-card mb-4">
                                <h4 class="checkout-section-title">
                                    <i class="fas fa-credit-card text-primary me-2"></i>Phương thức thanh toán
                                </h4>

                                <div class="d-flex flex-column gap-3">
                                    <label class="payment-option active d-flex align-items-center justify-content-between" onclick="selectPayment(this)">
                                        <div class="d-flex align-items-center gap-3">
                                            <input class="form-check-input mt-0" type="radio" name="paymentMethod" value="COD" checked>
                                            <div>
                                                <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                                                <small class="text-muted">Được mở hộp kiểm tra ngoại quan &amp; cấu hình máy trước khi thanh toán</small>
                                            </div>
                                        </div>
                                        <i class="fas fa-truck text-primary fs-4"></i>
                                    </label>

                                    <label class="payment-option d-flex align-items-center justify-content-between" onclick="selectPayment(this)">
                                        <div class="d-flex align-items-center gap-3">
                                            <input class="form-check-input mt-0" type="radio" name="paymentMethod" value="BANKING">
                                            <div>
                                                <div class="fw-bold text-dark">Chuyển khoản ngân hàng / Quét mã QR</div>
                                                <small class="text-muted">Thanh toán trực tuyến nhanh chóng, ưu tiên giao hỏa tốc trong ngày</small>
                                            </div>
                                        </div>
                                        <i class="fas fa-qrcode text-secondary fs-4"></i>
                                    </label>
                                </div>
                            </div>

                            <a href="/cart" class="text-decoration-none fw-semibold text-primary">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại giỏ hàng để chỉnh sửa
                            </a>
                        </div>

                        <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG & VOUCHER -->
                        <div class="col-lg-5">
                            <div class="checkout-card order-summary-sticky">
                                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                                    <h4 class="fw-extrabold text-dark mb-0" style="font-size: 19px;">Đơn hàng của bạn</h4>
                                    <span class="badge rounded-pill px-3 py-1 fw-semibold"
                                        style="background-color: rgba(129, 196, 8, 0.14); color: #5a8d03;">
                                        <%= cartDetails.length %> sản phẩm
                                    </span>
                                </div>

                                <!-- Danh sách sản phẩm đặt mua -->
                                <div class="mb-3" style="max-height: 270px; overflow-y: auto; padding-right: 4px;">
                                    <% cartDetails.forEach(function(cartDetail) { %>
                                        <div class="order-item-row">
                                            <div class="order-item-thumb">
                                                <img src="/images/product/<%= cartDetail.product.thumbnail %>" alt="<%= cartDetail.product.name %>">
                                                <span class="order-item-qty"><%= cartDetail.quantity %></span>
                                            </div>
                                            <div class="flex-grow-1 min-w-0">
                                                <a href="/detail-product/<%= cartDetail.product.id %>" target="_blank"
                                                    class="text-dark fw-bold text-decoration-none d-block text-truncate small"
                                                    title="<%= cartDetail.product.name %>">
                                                    <%= cartDetail.product.name %>
                                                </a>
                                                <small class="text-muted">
                                                    Đơn giá: <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(cartDetail.priceCurr) %>
                                                </small>
                                            </div>
                                            <div class="text-end fw-bold text-dark small text-nowrap">
                                                <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(cartDetail.quantity * cartDetail.priceCurr) %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                                <!-- Khối áp dụng Mã giảm giá (Voucher) -->
                                <div class="border-top pt-3 mb-3">
                                    <label class="form-label small fw-bold text-dark mb-2">
                                        <i class="fas fa-ticket-alt text-primary me-1"></i> Mã giảm giá (Voucher)
                                    </label>
                                    <div class="input-group">
                                        <input type="text" id="voucherCodeInput" class="form-control checkout-input text-uppercase"
                                            placeholder="Nhập mã ưu đãi (VD: LAPTOP500K)">
                                        <button type="button" id="applyVoucherBtn" class="btn btn-outline-primary fw-semibold px-3"
                                            style="border-radius: 0 10px 10px 0;">
                                            Áp dụng
                                        </button>
                                    </div>
                                    <small id="voucherMessage" class="d-block mt-1"></small>
                                </div>

                                <!-- Chi tiết tiền -->
                                <div class="border-top pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted">Tạm tính</span>
                                        <span class="fw-semibold text-dark" id="subTotalDisplay" data-raw-total="<%= totalPrice %>">
                                            <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(totalPrice) %>
                                        </span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-2" id="discountRow" style="display: none !important;">
                                        <span class="text-muted">Giảm giá Voucher</span>
                                        <span class="fw-bold text-success" id="discountDisplay">-0 đ</span>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted">Phí vận chuyển</span>
                                        <span class="badge px-3 py-1 rounded-pill fw-semibold"
                                            style="background-color: rgba(25, 135, 84, 0.12); color: #198754; border: 1px solid rgba(25, 135, 84, 0.28);">
                                            Miễn phí (0 đ)
                                        </span>
                                    </div>

                                    <hr class="my-3">

                                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                                        <span class="fw-bold text-dark fs-5">Tổng thanh toán</span>
                                        <div class="text-end">
                                            <p class="mb-0 fw-extrabold text-danger fs-4" id="finalTotalDisplay">
                                                <%= new Intl.NumberFormat('vi-VN', { style: "currency", currency: "VND" }).format(totalPrice) %>
                                            </p>
                                            <small class="text-muted">(Đã bao gồm VAT)</small>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn btn-primary text-white w-100 rounded-pill py-3 fw-bold text-uppercase shadow-sm">
                                        <i class="fas fa-check-circle me-2"></i> Xác nhận đặt hàng
                                    </button>

                                    <div class="mt-3 pt-3 border-top text-center small text-muted">
                                        <i class="fas fa-lock text-primary me-1"></i> Thông tin của bạn được bảo mật tuyệt đối
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <div class="checkout-card text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                    <h4 class="fw-bold mb-2">Không có sản phẩm nào để thanh toán</h4>
                    <p class="text-muted mb-4">Giỏ hàng của bạn hiện đang trống. Vui lòng chọn sản phẩm trước khi thanh toán.</p>
                    <a href="/products" class="btn btn-primary text-white rounded-pill px-5 py-3 fw-semibold">
                        Quay lại mua sắm
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    <!-- Checkout Page End -->

    <!-- Footer Start -->
    <%- include('../layout/footer') %>
    <!-- Footer End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top">
        <i class="fa fa-arrow-up"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/client/lib/easing/easing.min.js"></script>
    <script src="/client/lib/waypoints/waypoints.min.js"></script>
    <script src="/client/lib/lightbox/js/lightbox.min.js"></script>
    <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="/client/js/main.js"></script>

    <script>
        function selectPayment(labelEl) {
            document.querySelectorAll('.payment-option').forEach(el => el.classList.remove('active'));
            labelEl.classList.add('active');
        }

        // Xử lý kiểm tra và áp dụng Voucher qua API
        const applyBtn = document.getElementById('applyVoucherBtn');
        if (applyBtn) {
            applyBtn.addEventListener('click', async function () {
                const code = document.getElementById('voucherCodeInput').value.trim();
                const msgEl = document.getElementById('voucherMessage');
                const rawTotal = Number(document.getElementById('subTotalDisplay').dataset.rawTotal || 0);

                if (!code) {
                    msgEl.className = 'd-block mt-1 text-danger fw-semibold';
                    msgEl.textContent = 'Vui lòng nhập mã giảm giá.';
                    return;
                }

                try {
                    const res = await fetch('/api/apply-voucher', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code, orderTotal: rawTotal })
                    });
                    const data = await res.json();

                    if (!res.ok || !data.success) {
                        msgEl.className = 'd-block mt-1 text-danger fw-semibold';
                        msgEl.textContent = data.message || 'Mã giảm giá không hợp lệ hoặc đã hết hạn.';
                        return;
                    }

                    const discount = Number(data.discountAmount || 0);
                    const finalTotal = Math.max(0, rawTotal - discount);
                    const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

                    document.getElementById('voucherIdInput').value = data.voucherId;
                    document.getElementById('discountAmountInput').value = discount;
                    document.getElementById('finalTotalPriceInput').value = finalTotal;

                    const discountRow = document.getElementById('discountRow');
                    discountRow.style.removeProperty('display');
                    document.getElementById('discountDisplay').textContent = '-' + formatter.format(discount);
                    document.getElementById('finalTotalDisplay').textContent = formatter.format(finalTotal);

                    msgEl.className = 'd-block mt-1 text-success fw-semibold';
                    msgEl.textContent = 'Áp dụng mã thành công! Bạn được giảm ' + formatter.format(discount);
                } catch (err) {
                    msgEl.className = 'd-block mt-1 text-danger fw-semibold';
                    msgEl.textContent = 'Không thể kiểm tra mã lúc này, vui lòng thử lại.';
                }
            });
        }
    </script>
</body>

</html>