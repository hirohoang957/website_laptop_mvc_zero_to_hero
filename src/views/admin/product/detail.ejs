<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Xem và cập nhật thông tin chi tiết sản phẩm" />
    <meta name="author" content="Khiem" />
    <title>Cập nhật sản phẩm #<%= product.id %> - Trang quản trị</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <style>
        .form-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }
        .form-card .card-header {
            background-color: #fff;
            border-bottom: 1px solid #edf2f7;
            padding: 1rem 1.25rem;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .section-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: #334155;
        }
        .form-control, .form-select {
            border-radius: 8px;
            border-color: #cbd5e1;
            padding: 0.55rem 0.85rem;
            font-size: 0.92rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }
        .upload-zone {
            border: 2px dashed #cbd5e1;
            border-radius: 10px;
            background-color: #f8fafc;
            padding: 1.25rem;
            transition: all 0.2s ease;
        }
        .upload-zone:hover {
            border-color: #0d6efd;
            background-color: #f1f5f9;
        }
        .gallery-card {
            position: relative;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #fff;
            padding: 4px;
            transition: transform 0.15s ease;
        }
        .gallery-card:hover {
            transform: translateY(-2px);
        }
        .sticky-action-bar {
            position: sticky;
            bottom: 0;
            z-index: 100;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(6px);
            border-top: 1px solid #e2e8f0;
            padding: 1rem 1.5rem;
            border-radius: 12px;
        }
    </style>
</head>

<body class="sb-nav-fixed bg-light">
    <%- include('../layout/header') %>

    <div id="layoutSidenav">
        <%- include('../layout/sidenav') %>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 pb-5">
                    <!-- Header & Breadcrumb -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4 gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h2 class="fw-bold text-dark mb-0">Chi tiết & Cập nhật sản phẩm</h2>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                    ID #<%= product.id %>
                                </span>
                                <% if (product.hot === 1) { %>
                                    <span class="badge bg-warning text-dark px-2 py-1">
                                        <i class="fas fa-fire text-danger me-1"></i>Nổi bật
                                    </span>
                                <% } %>
                            </div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0 small">
                                    <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none">Bảng điều khiển</a></li>
                                    <li class="breadcrumb-item"><a href="/admin/product" class="text-decoration-none">Sản phẩm</a></li>
                                    <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
                                </ol>
                            </nav>
                        </div>
                        <a href="/admin/product" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-xl-10 col-12 mx-auto">
                            <!-- Hiển thị danh sách lỗi nếu có -->
                            <% if (errors && errors.length > 0) { %>
                                <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                                    <div class="fw-bold mb-1"><i class="fas fa-exclamation-circle me-2"></i>Cập nhật thất bại, vui lòng kiểm tra lại:</div>
                                    <ul class="mb-0 ps-3 small">
                                        <% errors.forEach(function(error) { %>
                                            <li><%= error %></li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>

                            <form action="/admin/handle-update-product" method="post" enctype="multipart/form-data">
                                <input name="id" type="hidden" value="<%= product.id %>">
                                <div id="deletedImagesContainer"></div>

                                <!-- 1. THÔNG TIN CƠ BẢN -->
                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-primary bg-opacity-10 text-primary">
                                                <i class="fas fa-info-circle"></i>
                                            </span>
                                            <span>1. Thông tin cơ bản</span>
                                        </div>
                                        <span class="badge bg-light text-secondary border fw-normal">
                                            Đã bán: <strong><%= product.sold ?? 0 %></strong> sản phẩm
                                        </span>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label">Tên sản phẩm <span class="text-danger">*</span></label>
                                                <input name="name" type="text" class="form-control"
                                                    value="<%= product?.name || '' %>" required>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Thương hiệu <span class="text-danger">*</span></label>
                                                <select name="brandId" class="form-select" required>
                                                    <option value="">-- Chọn thương hiệu --</option>
                                                    <% brands.forEach(function(brand) { %>
                                                        <option value="<%= brand.id %>" <%= String(product?.brandId) === String(brand.id) ? 'selected' : '' %>>
                                                            <%= brand.name %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                                                <select name="categoryId" class="form-select" required>
                                                    <option value="">-- Chọn danh mục --</option>
                                                    <% categories.forEach(function(category) { %>
                                                        <option value="<%= category.id %>" <%= String(product?.categoryId) === String(category.id) ? 'selected' : '' %>>
                                                            <%= category.name %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Mô tả ngắn <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" name="shortDesc"
                                                    value="<%= product?.shortDesc || '' %>" required>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Mô tả chi tiết <span class="text-danger">*</span></label>
                                                <textarea name="detailDesc" class="form-control" rows="8" required><%= product?.detailDesc || '' %></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. GIÁ BÁN, KHO HÀNG & TRẠNG THÁI -->
                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-success bg-opacity-10 text-success">
                                                <i class="fas fa-tags"></i>
                                            </span>
                                            <span>2. Giá bán, kho hàng & Trạng thái hiển thị</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <label class="form-label">Giá gốc (VNĐ) <span class="text-danger">*</span></label>
                                                <input name="priceOrigin" id="priceOriginInput" type="number" min="0" class="form-control"
                                                    value="<%= product?.priceOrigin ?? '' %>" required>
                                                <small class="text-muted" id="priceOriginFormatted"></small>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label">
                                                    Giá bán hiện tại (VNĐ) <span class="text-danger">*</span>
                                                    <span id="discountBadge" class="badge bg-danger ms-1" style="display: none;"></span>
                                                </label>
                                                <input name="priceCurr" id="priceCurrInput" type="number" min="0" class="form-control"
                                                    value="<%= product?.priceCurr ?? '' %>" required>
                                                <small class="text-muted" id="priceCurrFormatted"></small>
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label">Số lượng kho <span class="text-danger">*</span></label>
                                                <input name="quantity" type="number" min="0" class="form-control"
                                                    value="<%= product?.quantity ?? '' %>" required>
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label">Sản phẩm nổi bật</label>
                                                <select name="hot" class="form-select">
                                                    <option value="0" <%= String(product?.hot) !== '1' ? 'selected' : '' %>>Thường</option>
                                                    <option value="1" <%= String(product?.hot) === '1' ? 'selected' : '' %>>🔥 Nổi bật</option>
                                                </select>
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label">Trạng thái bán</label>
                                                <select name="status" class="form-select">
                                                    <option value="1" <%= String(product?.status) === '1' ? 'selected' : '' %>>Hoạt động</option>
                                                    <option value="0" <%= String(product?.status) === '0' ? 'selected' : '' %>>Khóa</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 3. CẤU HÌNH PHẦN CỨNG -->
                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-info bg-opacity-10 text-info">
                                                <i class="fas fa-microchip"></i>
                                            </span>
                                            <span>3. Cấu hình phần cứng</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-3">
                                            <!-- CPU -->
                                            <div class="col-md-6">
                                                <label class="form-label">Vi xử lý (CPU) <span class="text-danger">*</span></label>
                                                <input name="cpu" type="text" class="form-control"
                                                    placeholder="VD: Intel Core i7-13700H"
                                                    value="<%= product?.cpu || '' %>" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Dòng CPU (CPU Type) <span class="text-danger">*</span></label>
                                                <select name="cpuType" class="form-select" required>
                                                    <option value="">-- Chọn dòng CPU --</option>
                                                    <% const cpuTypes = ['Intel Core i3', 'Intel Core i5', 'Intel Core i7', 'Intel Core i9', 'Intel Core Ultra', 'AMD Ryzen 3', 'AMD Ryzen 5', 'AMD Ryzen 7', 'AMD Ryzen 9', 'Apple M1', 'Apple M2', 'Apple M3', 'Apple M4']; %>
                                                    <% cpuTypes.forEach(function(type) { %>
                                                        <option value="<%= type %>" <%= product?.cpuType === type ? 'selected' : '' %>><%= type %></option>
                                                    <% }); %>
                                                </select>
                                            </div>

                                            <!-- RAM -->
                                            <div class="col-md-6">
                                                <label class="form-label">Dung lượng RAM <span class="text-danger">*</span></label>
                                                <select name="ram" class="form-select" required>
                                                    <option value="">-- Chọn dung lượng RAM --</option>
                                                    <% const ramOptions = [4, 8, 16, 24, 32, 64, 128, 256]; %>
                                                    <% ramOptions.forEach(function(size) { %>
                                                        <option value="<%= size %>" <%= String(product?.ram) === String(size) ? 'selected' : '' %>>
                                                            <%= size %> GB
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Chuẩn RAM <span class="text-danger">*</span></label>
                                                <select name="ramType" class="form-select" required>
                                                    <option value="">-- Chọn chuẩn RAM --</option>
                                                    <% const ramTypes = ['DDR3', 'DDR4', 'DDR5', 'LPDDR4X', 'LPDDR5', 'LPDDR5X', 'Unified Memory']; %>
                                                    <% ramTypes.forEach(function(type) { %>
                                                        <option value="<%= type %>" <%= product?.ramType === type ? 'selected' : '' %>><%= type %></option>
                                                    <% }); %>
                                                </select>
                                            </div>

                                            <!-- STORAGE -->
                                            <div class="col-md-6">
                                                <label class="form-label">Dung lượng ổ cứng <span class="text-danger">*</span></label>
                                                <select name="storage" class="form-select" required>
                                                    <option value="">-- Chọn dung lượng lưu trữ --</option>
                                                    <% const storageOptions = [
                                                        { value: 128, label: '128 GB' },
                                                        { value: 256, label: '256 GB' },
                                                        { value: 512, label: '512 GB' },
                                                        { value: 1024, label: '1 TB (1024 GB)' },
                                                        { value: 2048, label: '2 TB (2048 GB)' },
                                                        { value: 4096, label: '4 TB (4096 GB)' }
                                                    ]; %>
                                                    <% storageOptions.forEach(function(item) { %>
                                                        <option value="<%= item.value %>" <%= String(product?.storage) === String(item.value) ? 'selected' : '' %>>
                                                            <%= item.label %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Loại ổ cứng <span class="text-danger">*</span></label>
                                                <select name="storageType" class="form-select" required>
                                                    <option value="">-- Chọn chuẩn ổ cứng --</option>
                                                    <% const storageTypes = ['SSD NVMe PCIe Gen 3', 'SSD NVMe PCIe Gen 4', 'SSD NVMe PCIe Gen 5', 'SSD SATA', 'SSD', 'HDD']; %>
                                                    <% storageTypes.forEach(function(type) { %>
                                                        <option value="<%= type %>" <%= product?.storageType === type ? 'selected' : '' %>><%= type %></option>
                                                    <% }); %>
                                                </select>
                                            </div>

                                            <!-- GPU -->
                                            <div class="col-md-6">
                                                <label class="form-label">Card đồ họa (GPU) <span class="text-danger">*</span></label>
                                                <input name="gpu" type="text" class="form-control"
                                                    placeholder="VD: NVIDIA GeForce RTX 4060 8GB"
                                                    value="<%= product?.gpu || '' %>" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Loại card đồ họa <span class="text-danger">*</span></label>
                                                <select name="gpuType" class="form-select" required>
                                                    <option value="">-- Chọn loại GPU --</option>
                                                    <option value="Onboard" <%= product?.gpuType === 'Onboard' ? 'selected' : '' %>>Card tích hợp (Onboard)</option>
                                                    <option value="Dedicated" <%= product?.gpuType === 'Dedicated' ? 'selected' : '' %>>Card rời (Dedicated)</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 4. MÀN HÌNH, PIN & THIẾT KẾ -->
                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-warning bg-opacity-10 text-warning">
                                                <i class="fas fa-desktop"></i>
                                            </span>
                                            <span>4. Màn hình, Pin & Thiết kế</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-3">
                                            <div class="col-md-4">
                                                <label class="form-label">Kích thước màn hình (inch) <span class="text-danger">*</span></label>
                                                <input name="screenSize" type="number" step="0.1" min="10" max="20" class="form-control"
                                                    placeholder="VD: 15.6"
                                                    value="<%= product?.screenSize || '' %>" required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Độ phân giải <span class="text-danger">*</span></label>
                                                <select name="resolution" class="form-select" required>
                                                    <option value="">-- Chọn độ phân giải --</option>
                                                    <% const resolutionOptions = [
                                                        '1366x768 (HD)',
                                                        '1920x1080 (Full HD)',
                                                        '1920x1200 (WUXGA / FHD+)',
                                                        '2560x1440 (2K QHD)',
                                                        '2560x1600 (2.5K WQXGA)',
                                                        '2560x1664 (Liquid Retina)',
                                                        '2880x1800 (2.8K OLED)',
                                                        '3024x1964 (Liquid Retina XDR)',
                                                        '3456x2234 (3.5K Liquid Retina XDR)',
                                                        '3840x2160 (4K UHD)',
                                                        '3840x2400 (4K+ WQUXGA)'
                                                    ]; %>
                                                    <% resolutionOptions.forEach(function(res) { %>
                                                        <option value="<%= res %>" <%= product?.resolution === res ? 'selected' : '' %>>
                                                            <%= res %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Hệ điều hành (OS) <span class="text-danger">*</span></label>
                                                <select name="os" class="form-select" required>
                                                    <option value="">-- Chọn hệ điều hành --</option>
                                                    <% const osOptions = ['Windows 11 Home', 'Windows 11 Pro', 'Windows 10 Home', 'Windows 10 Pro', 'macOS', 'Linux / Ubuntu', 'FreeDOS / No OS']; %>
                                                    <% osOptions.forEach(function(osItem) { %>
                                                        <option value="<%= osItem %>" <%= product?.os === osItem ? 'selected' : '' %>><%= osItem %></option>
                                                    <% }); %>
                                                </select>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Dung lượng Pin <span class="text-danger">*</span></label>
                                                <input name="battery" type="text" class="form-control"
                                                    placeholder="VD: 4-cell, 72 Wh"
                                                    value="<%= product?.battery || '' %>" required>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Trọng lượng (kg) <span class="text-danger">*</span></label>
                                                <input name="weight" type="number" step="0.01" min="0.5" max="10" class="form-control"
                                                    placeholder="VD: 1.85"
                                                    value="<%= product?.weight || '' %>" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 5. HÌNH ẢNH SẢN PHẨM -->
                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-danger bg-opacity-10 text-danger">
                                                <i class="fas fa-images"></i>
                                            </span>
                                            <span>5. Quản lý hình ảnh sản phẩm</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-4">
                                            <!-- Ảnh đại diện chính -->
                                            <div class="col-md-5">
                                                <label for="thumbnailFile" class="form-label">Ảnh đại diện chính (Thumbnail)</label>
                                                <div class="upload-zone text-center">
                                                    <div class="mb-3 d-flex justify-content-center">
                                                        <% if (product.thumbnail) { %>
                                                            <img id="thumbnailPreview" src="/images/product/<%= product.thumbnail %>"
                                                                alt="Ảnh đại diện sản phẩm" class="img-thumbnail shadow-sm"
                                                                style="max-height: 200px; display: block; object-fit: contain; background: #fff;" />
                                                        <% } else { %>
                                                            <img id="thumbnailPreview" src="" alt="Xem trước ảnh đại diện"
                                                                class="img-thumbnail shadow-sm"
                                                                style="max-height: 200px; display: none; object-fit: contain; background: #fff;" />
                                                        <% } %>
                                                    </div>
                                                    <div class="small text-muted mb-2">Chọn ảnh mới nếu muốn thay thế ảnh đại diện hiện tại</div>
                                                    <input class="form-control form-control-sm" type="file" id="thumbnailFile"
                                                        accept=".png, .jpg, .jpeg, .webp" name="thumbnail">
                                                </div>
                                            </div>

                                            <!-- Danh sách ảnh chi tiết -->
                                            <div class="col-md-7">
                                                <!-- Ảnh chi tiết hiện có -->
                                                <div class="mb-3">
                                                    <label class="form-label d-flex justify-content-between align-items-center">
                                                        <span>Ảnh chi tiết hiện tại</span>
                                                        <span class="badge bg-secondary" id="oldGalleryCount">
                                                            <%= (product.image && product.image.length) ? product.image.length : 0 %> ảnh
                                                        </span>
                                                    </label>

                                                    <% if (product.image && product.image.length > 0) { %>
                                                        <div class="row g-2" id="oldGalleryContainer">
                                                            <% product.image.forEach(function(img) { %>
                                                                <div class="col-4 col-sm-3 old-image-item">
                                                                    <div class="gallery-card shadow-sm">
                                                                        <img src="/images/product/<%= img.filename %>"
                                                                            class="w-100 rounded" style="height: 95px; object-fit: cover;"
                                                                            alt="Ảnh chi tiết" />
                                                                        <button type="button"
                                                                            class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 py-0 px-1 btn-remove-old-img"
                                                                            data-id="<%= img.id %>" title="Xóa ảnh này">
                                                                            <i class="fas fa-times" style="font-size: 0.75rem;"></i>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            <% }); %>
                                                        </div>
                                                    <% } else { %>
                                                        <div class="p-3 bg-light rounded border text-muted small text-center">
                                                            Sản phẩm chưa có ảnh chi tiết nào.
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <!-- Upload thêm ảnh mới -->
                                                <div>
                                                    <label for="galleryFiles" class="form-label">Tải thêm ảnh chi tiết mới</label>
                                                    <div class="upload-zone">
                                                        <div class="small text-muted mb-2">
                                                            <i class="fas fa-plus-circle text-success me-1"></i>Giữ phím Ctrl / Shift để chọn nhiều ảnh bổ sung
                                                        </div>
                                                        <input class="form-control form-control-sm" type="file" id="galleryFiles"
                                                            accept=".png, .jpg, .jpeg, .webp" name="images" multiple>
                                                        <div id="newGalleryPreview" class="row g-2 mt-2"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- THANH NÚT THAO TÁC CỐ ĐỊNH -->
                                <div class="sticky-action-bar shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="small text-muted">
                                        <i class="far fa-clock me-1"></i>Cập nhật lần cuối:
                                        <strong><%= product.updatedAt ? new Date(product.updatedAt).toLocaleString('vi-VN') : 'Chưa rõ' %></strong>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/product" class="btn btn-light border px-4 fw-semibold">
                                            <i class="fas fa-times me-1"></i> Hủy bỏ
                                        </a>
                                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                            <i class="fas fa-save me-1"></i> Lưu thay đổi
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </main>
            <%- include('../layout/footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/admin/js/scripts.js"></script>
    <script>
        $(document).ready(function () {
            // 1. Preview Thumbnail mới
            $("#thumbnailFile").change(function (e) {
                if (e.target.files && e.target.files[0]) {
                    const imgURL = URL.createObjectURL(e.target.files[0]);
                    $("#thumbnailPreview").attr("src", imgURL).fadeIn(200);
                }
            });

            // 2. Preview nhiều ảnh con mới chọn thêm
            $("#galleryFiles").change(function (e) {
                const previewContainer = $("#newGalleryPreview");
                previewContainer.empty();

                const files = e.target.files;
                if (files && files.length > 0) {
                    Array.from(files).forEach(function (file, index) {
                        const imgURL = URL.createObjectURL(file);
                        const col = $(`
                            <div class="col-4 col-sm-3">
                                <div class="gallery-card shadow-sm">
                                    <img src="${imgURL}" class="w-100 rounded" style="height: 95px; object-fit: cover;" alt="Ảnh mới ${index + 1}" />
                                    <span class="badge bg-success position-absolute top-0 start-0 m-1" style="font-size: 0.65rem;">Mới</span>
                                </div>
                            </div>
                        `);
                        previewContainer.append(col);
                    });
                }
            });

            // 3. Xóa ảnh con cũ trên giao diện & lưu ID vào input ẩn để backend xóa khỏi DB
            $(".btn-remove-old-img").click(function () {
                const imgId = $(this).data("id");
                const wrapper = $(this).closest(".old-image-item");

                $("#deletedImagesContainer").append(
                    `<input type="hidden" name="deletedImageIds[]" value="${imgId}">`
                );
                wrapper.fadeOut(150, function () {
                    $(this).remove();
                    const remaining = $(".old-image-item").length;
                    $("#oldGalleryCount").text(remaining + " ảnh");
                });
            });

            // 4. Hiển thị định dạng tiền tệ & tự động tính % giảm giá
            function updatePriceHelper() {
                const origin = parseInt($("#priceOriginInput").val(), 10) || 0;
                const curr = parseInt($("#priceCurrInput").val(), 10) || 0;

                $("#priceOriginFormatted").text(origin > 0 ? origin.toLocaleString("vi-VN") + " VNĐ" : "");
                $("#priceCurrFormatted").text(curr > 0 ? curr.toLocaleString("vi-VN") + " VNĐ" : "");

                if (origin > 0 && curr > 0 && origin > curr) {
                    const percent = Math.round(((origin - curr) / origin) * 100);
                    $("#discountBadge").text("-" + percent + "%").show();
                } else {
                    $("#discountBadge").hide();
                }
            }

            $("#priceOriginInput, #priceCurrInput").on("input", updatePriceHelper);
            updatePriceHelper();
        });
    </script>
</body>

</html>