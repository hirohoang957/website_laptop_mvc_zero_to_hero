<style>
    .admin-topbar {
        background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        height: 60px;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.18);
        z-index: 1039;
    }
    .admin-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: 0.3px;
        color: #fff !important;
        text-decoration: none;
    }
    .brand-logo-badge {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.95rem;
        box-shadow: 0 3px 8px rgba(37, 99, 235, 0.4);
    }
    .btn-sidebar-toggle {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        color: #cbd5e1 !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }
    .btn-sidebar-toggle:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff !important;
    }
    .btn-storefront {
        background-color: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #e2e8f0;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.38rem 0.85rem;
        transition: all 0.2s ease;
    }
    .btn-storefront:hover {
        background-color: rgba(59, 130, 246, 0.2);
        border-color: rgba(59, 130, 246, 0.5);
        color: #fff;
    }
    .admin-profile-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 10px 4px 6px !important;
        border-radius: 10px;
        background-color: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #f8fafc !important;
        transition: all 0.2s ease;
    }
    .admin-profile-btn:hover,
    .admin-profile-btn[aria-expanded="true"] {
        background-color: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.2);
    }
    .admin-avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        object-fit: cover;
    }
    .admin-dropdown-menu {
        border: none;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);
        padding: 0.5rem;
        min-width: 220px;
        margin-top: 10px !important;
    }
    .admin-dropdown-menu .dropdown-item {
        border-radius: 8px;
        padding: 0.5rem 0.85rem;
        font-size: 0.88rem;
        font-weight: 500;
        color: #334155;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .admin-dropdown-menu .dropdown-item:hover {
        background-color: #f1f5f9;
        color: #0f172a;
    }
    .admin-dropdown-menu .dropdown-item.text-danger:hover {
        background-color: #fef2f2;
        color: #dc2626 !important;
    }
</style>

<%
    const currentUser = typeof user !== 'undefined' && user ? user : null;
    const adminName = currentUser?.fullName || 'Khiêm';
    const adminEmail = currentUser?.username || 'Quản trị viên hệ thống';
    const adminInitial = adminName.charAt(0).toUpperCase();
%>

<nav class="sb-topnav navbar navbar-expand navbar-dark admin-topbar">
    <!-- Logo & Tên hệ thống -->
    <a class="navbar-brand ps-3 admin-brand" href="/admin">
        <!-- <span class="brand-logo-badge">
            <i class="fas fa-laptop-code"></i>
        </span> -->
        <span>Laptopshop <span class="badge bg-primary bg-opacity-25 text-info fw-semibold ms-1" style="font-size: 0.65rem; vertical-align: middle;">ADMIN</span></span>
    </a>

    <!-- Nút thu gọn Sidebar -->
    <button class="btn btn-link btn-sm order-1 order-lg-0 me-3 me-lg-0 btn-sidebar-toggle" id="sidebarToggle" type="button" title="Thu gọn / Mở rộng menu">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Khu vực bên phải -->
    <div class="ms-auto d-flex align-items-center gap-3 me-3 me-lg-4">
        <!-- Nút mở nhanh trang khách hàng -->
        <a href="/" target="_blank" class="btn btn-storefront d-none d-md-inline-flex align-items-center gap-2" title="Mở giao diện cửa hàng ở tab mới">
            <i class="fas fa-external-link-alt"></i>
            <span>Xem trang bán hàng</span>
        </a>

        <!-- Dropdown tài khoản Admin -->
        <ul class="navbar-nav">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle admin-profile-btn" id="navbarDropdown" href="#" role="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    <% if (currentUser?.avatar) { %>
                        <img src="/images/<%= currentUser.avatar %>" alt="<%= adminName %>" class="admin-avatar-circle">
                    <% } else { %>
                        <span class="admin-avatar-circle"><%= adminInitial %></span>
                    <% } %>
                    <div class="d-none d-sm-block text-start lh-1">
                        <div class="fw-semibold" style="font-size: 0.85rem;">Xin chào, <%= adminName %></div>
                        <small class="text-info" style="font-size: 0.7rem;">Quản trị viên</small>
                    </div>
                </a>

                <ul class="dropdown-menu dropdown-menu-end admin-dropdown-menu" aria-labelledby="navbarDropdown">
                    <li class="px-3 py-2 border-bottom mb-1">
                        <div class="fw-bold text-dark small"><%= adminName %></div>
                        <div class="text-muted text-truncate" style="font-size: 0.75rem; max-width: 190px;"><%= adminEmail %></div>
                    </li>
                    <% if (currentUser?.id) { %>
                        <li>
                            <a class="dropdown-item" href="/admin/handle-view-user/<%= currentUser.id %>">
                                <i class="fas fa-user-cog text-primary" style="width: 16px;"></i>
                                <span>Hồ sơ cá nhân</span>
                            </a>
                        </li>
                    <% } %>
                    <li>
                        <a class="dropdown-item d-md-none" href="/" target="_blank">
                            <i class="fas fa-store text-success" style="width: 16px;"></i>
                            <span>Xem trang bán hàng</span>
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/admin">
                            <i class="fas fa-tachometer-alt text-info" style="width: 16px;"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider my-1" />
                    </li>
                    <li>
                        <form method="post" action="/logout" class="m-0">
                            <button type="submit" class="dropdown-item text-danger fw-semibold">
                                <i class="fas fa-sign-out-alt" style="width: 16px;"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</nav>