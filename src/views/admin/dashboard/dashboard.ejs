<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Bảng điều khiển - LaptopShop Admin</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background-color: #f8fafc;
        }
        .kpi-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: #ffffff;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08) !important;
        }
        .kpi-icon-box {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }
        .dashboard-panel {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: #ffffff;
        }
        .table-modern th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.85rem 1rem;
        }
        .table-modern td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }
        .quick-action-btn {
            border-radius: 12px;
            padding: 0.75rem 1rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #1e293b;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .quick-action-btn:hover {
            background: #eff6ff;
            border-color: #93c5fd;
            color: #1d4ed8;
        }
    </style>
</head>

<body class="sb-nav-fixed">
    <%- include('../layout/header') %>

    <%
        const statsData = typeof stats !== 'undefined' && stats ? stats : {
            totalRevenue: 0,
            totalOrders: 0,
            pendingOrders: 0,
            totalProducts: 0,
            lowStockCount: 0,
            totalUsers: 0
        };
        const recentOrdersList = typeof recentOrders !== 'undefined' && Array.isArray(recentOrders) ? recentOrders : [];
        const lowStockList = typeof lowStockProducts !== 'undefined' && Array.isArray(lowStockProducts) ? lowStockProducts : [];
        const chartDataObj = typeof chartData !== 'undefined' && chartData ? chartData : {
            revenueLabels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
            revenueValues: [0, 0, 0, 0, 0, 0, 0],
            statusCounts: [0, 0, 0, 0, 0]
        };

        const formatCurrency = (val) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val || 0);

        const statusBadgeMap = {
            PENDING: { label: 'Chờ xác nhận', cls: 'bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25' },
            PROCESSING: { label: 'Đang xử lý', cls: 'bg-info bg-opacity-10 text-info border border-info border-opacity-25' },
            SHIPPING: { label: 'Đang giao', cls: 'bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25' },
            COMPLETED: { label: 'Hoàn thành', cls: 'bg-success bg-opacity-10 text-success border border-success border-opacity-25' },
            CANCELLED: { label: 'Đã hủy', cls: 'bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25' },
            REFUNDED: { label: 'Hoàn tiền', cls: 'bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25' }
        };
    %>

    <div id="layoutSidenav">
        <%- include('../layout/sidenav') %>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 pb-5">
                    <!-- Header Banner -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4 gap-3">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">Bảng điều khiển tổng quan</h2>
                            <p class="text-muted small mb-0">
                                Theo dõi hiệu suất kinh doanh, tình trạng đơn hàng và kho sản phẩm của <strong class="text-dark">LaptopShop</strong>.
                            </p>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/admin/create-product" class="btn btn-primary btn-sm px-3 py-2 rounded-3 fw-semibold shadow-sm">
                                <i class="fas fa-plus me-1"></i> Thêm sản phẩm
                            </a>
                            <a href="/admin/order" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold bg-white">
                                <i class="fas fa-shopping-bag me-1"></i> Quản lý đơn hàng
                            </a>
                        </div>
                    </div>

                    <!-- 4 KPI Cards -->
                    <div class="row g-3 mb-4">
                        <!-- Doanh thu -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card kpi-card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="text-muted small fw-semibold text-uppercase mb-1">Tổng doanh thu</div>
                                            <h4 class="fw-bold text-dark mb-0"><%= formatCurrency(statsData.totalRevenue) %></h4>
                                        </div>
                                        <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                                            <i class="fas fa-coins"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                                        <span class="text-muted">Đơn hoàn thành & đã thu</span>
                                        <a href="/admin/order" class="text-success fw-semibold text-decoration-none">
                                            Chi tiết <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Đơn hàng -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card kpi-card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="text-muted small fw-semibold text-uppercase mb-1">Tổng đơn hàng</div>
                                            <h4 class="fw-bold text-dark mb-0"><%= statsData.totalOrders %> <span class="fs-6 fw-normal text-muted">đơn</span></h4>
                                        </div>
                                        <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                                            <i class="fas fa-shopping-cart"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                                        <% if (statsData.pendingOrders > 0) { %>
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock me-1"></i><%= statsData.pendingOrders %> chờ xác nhận
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted">Không có đơn chờ duyệt</span>
                                        <% } %>
                                        <a href="/admin/order" class="text-primary fw-semibold text-decoration-none">
                                            Xử lý <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sản phẩm -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card kpi-card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="text-muted small fw-semibold text-uppercase mb-1">Sản phẩm kinh doanh</div>
                                            <h4 class="fw-bold text-dark mb-0"><%= statsData.totalProducts %> <span class="fs-6 fw-normal text-muted">mẫu</span></h4>
                                        </div>
                                        <div class="kpi-icon-box bg-info bg-opacity-10 text-info">
                                            <i class="fas fa-laptop"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                                        <% if (statsData.lowStockCount > 0) { %>
                                            <span class="text-danger fw-semibold">
                                                <i class="fas fa-exclamation-triangle me-1"></i><%= statsData.lowStockCount %> sắp hết hàng
                                            </span>
                                        <% } else { %>
                                            <span class="text-success fw-semibold"><i class="fas fa-check-circle me-1"></i>Tồn kho ổn định</span>
                                        <% } %>
                                        <a href="/admin/product" class="text-info fw-semibold text-decoration-none">
                                            Kho hàng <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Khách hàng -->
                        <div class="col-xl-3 col-md-6">
                            <div class="card kpi-card shadow-sm h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <div class="text-muted small fw-semibold text-uppercase mb-1">Tài khoản người dùng</div>
                                            <h4 class="fw-bold text-dark mb-0"><%= statsData.totalUsers %> <span class="fs-6 fw-normal text-muted">tài khoản</span></h4>
                                        </div>
                                        <div class="kpi-icon-box bg-warning bg-opacity-10 text-warning">
                                            <i class="fas fa-users"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-2 border-top small">
                                        <span class="text-muted">Khách hàng & Quản trị</span>
                                        <a href="/admin/user" class="text-warning fw-semibold text-decoration-none">
                                            Danh sách <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Row -->
                    <div class="row g-4 mb-4">
                        <!-- Biểu đồ doanh thu 7 ngày -->
                        <div class="col-xl-8">
                            <div class="card dashboard-panel shadow-sm h-100">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="fas fa-chart-area text-primary me-2"></i>Biểu đồ doanh thu 7 ngày gần nhất
                                        </h6>
                                        <small class="text-muted">Tính trên các đơn hàng không bị hủy</small>
                                    </div>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Đơn vị: VNĐ</span>
                                </div>
                                <div class="card-body p-4">
                                    <div style="height: 290px;">
                                        <canvas id="revenueChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Biểu đồ tỷ lệ trạng thái đơn hàng -->
                        <div class="col-xl-4">
                            <div class="card dashboard-panel shadow-sm h-100">
                                <div class="card-header bg-white border-bottom py-3 px-4">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fas fa-chart-pie text-info me-2"></i>Tỷ lệ trạng thái đơn hàng
                                    </h6>
                                    <small class="text-muted">Phân bổ toàn bộ đơn hàng trên hệ thống</small>
                                </div>
                                <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center">
                                    <div style="height: 240px; width: 100%; max-width: 260px;">
                                        <canvas id="orderStatusChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Row: Đơn hàng gần đây & Tồn kho thấp / Thao tác nhanh -->
                    <div class="row g-4">
                        <!-- Bảng đơn hàng mới nhất -->
                        <div class="col-xl-8">
                            <div class="card dashboard-panel shadow-sm h-100">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold text-dark mb-0">
                                        <i class="fas fa-clock text-warning me-2"></i>Đơn hàng mới nhất
                                    </h6>
                                    <a href="/admin/order" class="btn btn-sm btn-outline-primary rounded-3 fw-semibold">
                                        Xem tất cả
                                    </a>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-modern mb-0">
                                        <thead>
                                            <tr>
                                                <th class="ps-4">Mã đơn</th>
                                                <th>Khách hàng</th>
                                                <th>Tổng tiền</th>
                                                <th>Trạng thái</th>
                                                <th class="text-end pe-4">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (recentOrdersList.length === 0) { %>
                                                <tr>
                                                    <td colspan="5" class="text-center py-5 text-muted">
                                                        <i class="fas fa-inbox fa-2x mb-2 opacity-50 d-block"></i>
                                                        Chưa có đơn hàng nào được tạo.
                                                    </td>
                                                </tr>
                                            <% } else { %>
                                                <% recentOrdersList.forEach(order => { 
                                                    const st = statusBadgeMap[(order.status || '').toUpperCase()] || { label: order.status, cls: 'bg-secondary text-white' };
                                                %>
                                                    <tr>
                                                        <td class="ps-4 fw-bold text-primary">#<%= order.id %></td>
                                                        <td>
                                                            <div class="fw-semibold text-dark"><%= order.receiverName %></div>
                                                            <div class="small text-muted"><%= order.receiverPhone %></div>
                                                        </td>
                                                        <td class="fw-bold text-dark"><%= formatCurrency(order.totalPrice) %></td>
                                                        <td>
                                                            <span class="badge <%= st.cls %> px-2 py-1 rounded-pill"><%= st.label %></span>
                                                        </td>
                                                        <td class="text-end pe-4">
                                                            <a href="/admin/handle-view-order/<%= order.id %>" class="btn btn-sm btn-light border">
                                                                <i class="fas fa-eye text-primary"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Cột phải: Cảnh báo tồn kho & Truy cập nhanh -->
                        <div class="col-xl-4">
                            <div class="d-flex flex-column gap-4 h-100">
                                <!-- Cảnh báo sắp hết hàng -->
                                <div class="card dashboard-panel shadow-sm">
                                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="fas fa-exclamation-circle text-danger me-2"></i>Sản phẩm sắp hết hàng
                                        </h6>
                                        <span class="badge bg-danger bg-opacity-10 text-danger">&le; 5 máy</span>
                                    </div>
                                    <div class="card-body p-3">
                                        <% if (lowStockList.length === 0) { %>
                                            <div class="text-center py-3 text-muted small">
                                                <i class="fas fa-check-circle text-success me-1"></i> Tất cả sản phẩm đều còn đủ hàng trong kho.
                                            </div>
                                        <% } else { %>
                                            <div class="list-group list-group-flush">
                                                <% lowStockList.forEach(prod => { %>
                                                    <a href="/admin/handle-view-product/<%= prod.id %>" class="list-group-item list-group-item-action px-2 py-2 border-0 rounded-3 d-flex align-items-center justify-content-between">
                                                        <div class="text-truncate pe-2">
                                                            <div class="fw-semibold text-dark small text-truncate"><%= prod.name %></div>
                                                            <div class="text-muted" style="font-size: 0.75rem;">Đã bán: <%= prod.sold %></div>
                                                        </div>
                                                        <span class="badge <%= prod.quantity === 0 ? 'bg-danger' : 'bg-warning text-dark' %> rounded-pill">
                                                            Còn <%= prod.quantity %>
                                                        </span>
                                                    </a>
                                                <% }) %>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Lối tắt quản lý -->
                                <div class="card dashboard-panel shadow-sm flex-grow-1">
                                    <div class="card-header bg-white border-bottom py-3 px-4">
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="fas fa-bolt text-primary me-2"></i>Thao tác nhanh
                                        </h6>
                                    </div>
                                    <div class="card-body p-3 d-flex flex-column gap-2">
                                        <a href="/admin/create-product" class="quick-action-btn">
                                            <span><i class="fas fa-laptop-medical text-primary me-2"></i>Đăng bán Laptop mới</span>
                                            <i class="fas fa-chevron-right small text-muted"></i>
                                        </a>
                                        <a href="/admin/create-brand" class="quick-action-btn">
                                            <span><i class="fas fa-copyright text-info me-2"></i>Thêm thương hiệu mới</span>
                                            <i class="fas fa-chevron-right small text-muted"></i>
                                        </a>
                                        <a href="/admin/create-category" class="quick-action-btn">
                                            <span><i class="fas fa-folder-plus text-success me-2"></i>Thêm danh mục sản phẩm</span>
                                            <i class="fas fa-chevron-right small text-muted"></i>
                                        </a>
                                        <a href="/admin/create-user" class="quick-action-btn">
                                            <span><i class="fas fa-user-plus text-warning me-2"></i>Tạo tài khoản mới</span>
                                            <i class="fas fa-chevron-right small text-muted"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
            <%- include('../layout/footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/admin/js/scripts.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const rawChartData = <%- JSON.stringify(chartDataObj) %>;

            // 1. Biểu đồ doanh thu 7 ngày
            const revCtx = document.getElementById('revenueChart');
            if (revCtx) {
                new Chart(revCtx, {
                    type: 'line',
                    data: {
                        labels: rawChartData.revenueLabels,
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: rawChartData.revenueValues,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            borderWidth: 3,
                            tension: 0.35,
                            fill: true,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#2563eb',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        return ' ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(ctx.parsed.y);
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#f1f5f9' },
                                ticks: {
                                    callback: function (value) {
                                        if (value >= 1000000) return (value / 1000000) + ' Tr';
                                        if (value >= 1000) return (value / 1000) + ' K';
                                        return value;
                                    }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // 2. Biểu đồ trạng thái đơn hàng
            const statusCtx = document.getElementById('orderStatusChart');
            if (statusCtx) {
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Chờ xác nhận', 'Đang xử lý', 'Đang giao', 'Hoàn thành', 'Đã hủy'],
                        datasets: [{
                            data: rawChartData.statusCounts,
                            backgroundColor: ['#f59e0b', '#06b6d4', '#3b82f6', '#22c55e', '#ef4444'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true,
                                    padding: 14,
                                    font: { size: 12 }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>