<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Xem và cập nhật thông tin danh mục sản phẩm" />
    <meta name="author" content="Khiem" />
    <title>Chi tiết danh mục #<%= category.id %> - Trang quản trị</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
        .form-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }
        .form-card .card-header {
            background-color: #fff;
            border-bottom: 1px solid #edf2f7;
            padding: 1rem 1.25rem;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .section-title-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: #334155;
        }
        .form-control {
            border-radius: 8px;
            border-color: #cbd5e1;
            padding: 0.55rem 0.85rem;
            font-size: 0.92rem;
        }
        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
        }
    </style>
</head>

<body class="sb-nav-fixed bg-light">
    <%- include('../layout/header') %>

    <div id="layoutSidenav">
        <%- include('../layout/sidenav') %>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 pb-5">
                    <!-- Header & Breadcrumb -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4 gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h2 class="fw-bold text-dark mb-0">Chi tiết & Cập nhật danh mục</h2>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                    ID #<%= category.id %>
                                </span>
                            </div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0 small">
                                    <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none">Bảng điều khiển</a></li>
                                    <li class="breadcrumb-item"><a href="/admin/category" class="text-decoration-none">Danh mục</a></li>
                                    <li class="breadcrumb-item active" aria-current="page"><%= category.name %></li>
                                </ol>
                            </nav>
                        </div>
                        <a href="/admin/category" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-3 fw-semibold">
                            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>

                    <div class="row">
                        <div class="col-lg-6 col-md-8 col-12 mx-auto">
                            <!-- Hiển thị danh sách lỗi nếu có -->
                            <% if (errors && errors.length > 0) { %>
                                <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4">
                                    <div class="fw-bold mb-1"><i class="fas fa-exclamation-circle me-2"></i>Cập nhật thất bại, vui lòng kiểm tra lại:</div>
                                    <ul class="mb-0 ps-3 small">
                                        <% errors.forEach(function(error) { %>
                                            <li><%= error %></li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>

                            <form action="/admin/handle-update-category" method="post">
                                <input name="id" type="hidden" value="<%= category.id %>">

                                <div class="card form-card shadow-sm mb-4">
                                    <div class="card-header">
                                        <div class="section-title-group">
                                            <span class="section-icon bg-primary bg-opacity-10 text-primary">
                                                <i class="fas fa-layer-group"></i>
                                            </span>
                                            <span>Thông tin danh mục</span>
                                        </div>
                                        <% if (category._count?.products !== undefined || category.products) { %>
                                            <span class="badge bg-light text-secondary border fw-normal">
                                                Đang có <strong><%= category._count?.products ?? category.products.length %></strong> sản phẩm
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="card-body p-4">
                                        <div class="mb-2">
                                            <label for="categoryName" class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                                            <input id="categoryName" name="name" type="text" class="form-control"
                                                placeholder="Nhập tên danh mục..." required
                                                value="<%= category.name %>">
                                            <div class="form-text small">Tên danh mục là duy nhất và không được trùng lặp trong hệ thống.</div>
                                        </div>
                                    </div>

                                    <!-- Footer nút thao tác -->
                                    <div class="card-footer bg-white py-3 px-4 border-top d-flex justify-content-end gap-2">
                                        <a href="/admin/category" class="btn btn-light border px-4 fw-semibold">
                                            <i class="fas fa-times me-1"></i> Hủy bỏ
                                        </a>
                                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                            <i class="fas fa-save me-1"></i> Lưu thay đổi
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </main>
            <%- include('../layout/footer') %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
    <script src="/admin/js/scripts.js"></script>
</body>

</html>