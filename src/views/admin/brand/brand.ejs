<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Manage Brands - Khiem</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>

<body class="sb-nav-fixed">
    <%- include('../layout/header') %>

        <div id="layoutSidenav">
            <%- include('../layout/sidenav') %>
                <div id="layoutSidenav_content">
                    <main>
                        <div class="container-fluid px-4">
                            <h1 class="mt-4">Manage Brands</h1>
                            <ol class="breadcrumb mb-4">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item active">Brands</li>
                            </ol>
                            <div>
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <h5>Table Brands</h5>
                                    <div>
                                        <a class="btn btn-warning" href="/admin/create-brand">Create a new brand</a>
                                    </div>
                                </div>
                                <hr />
                                <div>
                                    <table class="table table-hover table-bordered align-middle">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Name</th>
                                                <th>Logo</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% brands.forEach(function(brand) { %>
                                                <tr>
                                                    <td>
                                                        <%= brand.id %>
                                                    </td>
                                                    <td>
                                                        <%= brand.name %>
                                                    </td>
                                                    <td>
                                                        <% if (brand.logo) { %>
                                                            <img src="/images/brand/<%= brand.logo %>" alt="<%= brand.name %> logo"
                                                                style="max-height: 45px; max-width: 100px; object-fit: contain;" />
                                                        <% } else { %>
                                                            <span class="text-muted">No logo</span>
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <div style="display: flex; gap: 10px;">
                                                            <a href="/admin/handle-view-brand/<%= brand.id %>"
                                                                class="btn btn-primary btn-sm">View</a>
                                                            <form action="/admin/handle-delete-brand/<%= brand.id %>"
                                                                method="post" style="margin: 0;">
                                                                <button type="submit" class="btn btn-danger btn-sm"
                                                                    onclick="return confirm('Are you sure?')">Delete</button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </main>
                    <%- include('../layout/footer') %>
                </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        <script src="/admin/js/scripts.js"></script>
</body>

</html>